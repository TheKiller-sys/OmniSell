<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="16dp">

    <!-- HEADER CENTRADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/inventario_titulo"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/dark"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.5" />

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:background="@color/primary"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tv_stats_products"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Productos"
                android:textSize="14sp"
                android:textColor="@color/gray" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" · "
                android:textSize="14sp"
                android:textColor="@color/gray" />

            <TextView
                android:id="@+id/tv_updated_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inventario_actualizado"
                android:textSize="12sp"
                android:textColor="@color/success" />
        </LinearLayout>
    </LinearLayout>

    <!-- Barra de búsqueda -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/light_gray"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                android:tint="@color/gray" />

            <EditText
                android:id="@+id/et_search_inventario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Buscar productos..."
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:textSize="16sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Filtros por categoría (dinámicos) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/ll_filtros_categoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Grid de productos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_inventario"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="4dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <!-- Mensaje de inventario vacío -->
    <TextView
        android:id="@+id/tv_inventario_vacio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/inventario_vacio"
        android:textSize="14sp"
        android:textColor="@color/gray"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone" />

</LinearLayout>
